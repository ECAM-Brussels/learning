{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learning",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
}
