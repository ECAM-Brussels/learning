# Copy to .env and fill in the blanks. Values are for development.
# With `bun run docker`, the services reach each other by name instead of localhost:
# DATABASE_URL=postgres://learning:learning@postgres:5432/learning and SYMAPI_URL=http://symapi:8000
# (symapi-dev with `docker:dev`); the production SymAPI also reads WORKERS, its number of processes.

SYMAPI_URL=http://localhost:8088

POSTGRES_USER=learning
POSTGRES_PASSWORD=learning
POSTGRES_DB=learning
DATABASE_URL=postgres://learning:learning@localhost:5432/learning

BETTER_AUTH_URL=http://localhost:3000
# Any long random string, e.g. from `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# From an app registration in Microsoft Entra ID, for sign-in with Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Comma-separated emails of the users who get the admin role
ADMINS=you@example.com
