{
  "name": "learning",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsrx/prettier-plugin": "^0.6.3",
    "@tsrx/solid": "^0.3.5",
    "@types/bun": "latest",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mdx": "^3.10.1",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "turbo": "^2.9.18",
    "typescript-eslint": "^8.73.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "catalog": {
    "@cortex-js/compute-engine": "0.58.0",
    "@solidjs/diagnostics": "next",
    "@solidjs/meta": "next",
    "@solidjs/router": "next",
    "@solidjs/vite-plugin": "latest",
    "@solidjs/web": "next",
    "better-auth": "1.7.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "es-toolkit": "^1.47.1",
    "filesystem-routing": "latest",
    "@fortawesome/fontawesome-common-types": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "solid-js": "next",
    "valibot": "^1.3.1"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "codegen": "turbo run codegen",
    "db:start": "bun --env-file=.env --filter=@learning/db run db:start",
    "db:push": "bun install && bun --env-file=.env --filter=@learning/db run db:push",
    "dev": "bun install && bun --env-file=.env ./node_modules/turbo/bin/turbo run dev test:watch",
    "docker": "docker compose --profile prod up --build",
    "docker:dev": "docker compose --profile dev up --build",
    "lint": "turbo run lint && eslint . --fix && git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
    "lint:check": "turbo run lint:check && eslint . && git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --check --ignore-unknown --no-error-on-unmatched-pattern",
    "prepare": "lefthook install",
    "test": "bun --env-file=.env ./node_modules/turbo/bin/turbo run test",
    "test:watch": "bun --env-file=.env ./node_modules/turbo/bin/turbo run test:watch"
  },
  "workspaces": [
    "apps/*",
    "content/*",
    "packages/*"
  ]
}
