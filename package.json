{
  "name": "learning",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.9.18"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "catalog": {
    "@cortex-js/compute-engine": "0.58.0",
    "@solidjs/router": "0.17.0-next.1",
    "@solidjs/start": "^1.3.2",
    "@solidjs/web": "next",
    "es-toolkit": "^1.47.1",
    "solid-js": "next",
    "valibot": "^1.3.1",
    "vite-plugin-solid": "next"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "codegen": "turbo run codegen",
    "dev": "turbo run dev",
    "lint": "turbo run lint && prettier . --write",
    "lint:check": "turbo run lint:check && bun run prettier . --check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "workspaces": [
    "apps/*",
    "content/*",
    "packages/*"
  ]
}
