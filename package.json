{
  "name": "learning",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.9.18"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "catalog": {
    "@cortex-js/compute-engine": "0.58.0",
    "@solidjs/meta": "next",
    "@solidjs/router": "next",
    "@solidjs/vite-plugin": "next",
    "@solidjs/web": "next",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^1.0.0-rc.4",
    "es-toolkit": "^1.47.1",
    "filesystem-routing": "^0.2.1",
    "@fortawesome/fontawesome-common-types": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "solid-js": "next",
    "valibot": "^1.3.1"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "codegen": "turbo run codegen",
    "dev": "turbo run dev",
    "docker": "docker compose --profile prod up --build",
    "docker:dev": "docker compose --profile dev up --build",
    "lint": "turbo run lint && prettier . --write",
    "lint:check": "turbo run lint:check && bun run prettier . --check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "workspaces": [
    "apps/*",
    "content/*",
    "packages/*"
  ]
}
