{
  "name": "learning",
  "image": "mcr.microsoft.com/devcontainers/base:resolute",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers-extra/features/bun:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {}
  },
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/symapi"
  },
  "postCreateCommand": "uv python install \"$(cat apps/symapi/.python-version)\" && cd apps/symapi && uv sync --frozen --dev",
  "remoteEnv": {
    "PATH": "/home/vscode/.venvs/symapi/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "bierner.comment-tagged-templates",
        "bradlc.vscode-tailwindcss",
        "darkriszty.markdown-table-prettify",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "hipstersmoothie-public.mdx-tsc-vscode",
        "ms-python.python",
        "ms-python.black-formatter",
        "unifiedjs.vscode-mdx"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "prettier.configPath": "prettier.config.js",
        "prettier.prettierPath": "./node_modules/prettier",
        "python.defaultInterpreterPath": "/home/vscode/.venvs/symapi/bin/python"
      }
    }
  }
}
